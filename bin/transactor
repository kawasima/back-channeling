#!/bin/bash

datomic_version=1.0.7187
datomic_dir=datomic-pro-${datomic_version}

function get_datomic () {
  curl --progress-bar --location --url "https://datomic-pro-downloads.s3.amazonaws.com/${datomic_version}/datomic-pro-${datomic_version}.zip" --output datomic.zip
  unzip -x datomic.zip
}

if [ ! -e "${datomic_dir}" ]; then
   get_datomic
fi

exec "${datomic_dir}/bin/transactor" "${1:-${datomic_dir}/config/samples/dev-transactor-template.properties}"
