{;; Server connection
 :server-url "http://localhost:3009"

 ;; Bot user credentials (register via /signup with token auth)
 :bot-name "ai-bot"
 :bot-token "CHANGE_ME"

 :system-prompt "You are an AI assistant participating in a team chat. Be helpful, concise, and friendly. When responding to questions, consider the full conversation context. Format your responses in Markdown."

